# Copy this file to local.properties (which is gitignored) and fill in your
# own values. Never commit local.properties — it holds real credentials.
# See MANUAL_DEPLOY.md for exactly where each value comes from.

sdk.dir=/path/to/your/Android/sdk

# --- Firebase (Settings > AI Coach is separate; this is for login + cloud sync) ---
# From Firebase Console > Project settings > General > Your apps > Android app > Config
FIREBASE_API_KEY=
FIREBASE_APP_ID=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=

# From Firebase Console > Authentication > Sign-in method > Google > Web SDK configuration
# (this is a "Web application" OAuth client ID, NOT the Android one)
GOOGLE_WEB_CLIENT_ID=

# --- Strava (developers.strava.com > My API Application) ---
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
